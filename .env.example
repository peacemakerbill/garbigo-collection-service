# garbigo-collection-service - local environment
# Copy this to .env and fill in real values. Never commit the real .env file.

# This service's own MongoDB database (garbigo_collection - NOT garbigo_auth)
MONGODB_URI=mongodb://localhost:27017/garbigo_collection

# Must point at the SAME Redis instance auth-service uses, or a token
# revoked via auth-service's /auth/logout won't be rejected here.
REDIS_HOST=localhost
REDIS_PORT=6379

# Same RabbitMQ broker as auth-service.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Name of auth-service's existing user-created queue - same env var name
# auth-service uses on the publishing side, so one value covers both.
RABBITMQ_QUEUE_USER_CREATED=user-created-queue

# Code-only alternative to purging queues via the RabbitMQ UI - see
# QueuePurgeRunner. Leave false; flip to true for one restart only when you
# actually need to drain user-created-queue, then set back to false.
PURGE_QUEUES_ON_STARTUP=false

# Must be the IDENTICAL value configured in auth-service, or every JWT
# signature check on an incoming token fails.
JWT_SECRET=

# Must be the IDENTICAL value configured in auth-service's InternalApiKeyFilter.
INTERNAL_API_KEY=

# Base URL for Feign calls into auth-service.
AUTH_SERVICE_URL=http://localhost:8080

# Not called anywhere yet - garbigo-wallet-service doesn't exist. Safe to
# leave as the default; only matters once WalletServiceClient is actually used.
WALLET_SERVICE_URL=http://localhost:8082

# SMTP config for MailService's transactional emails. Same defaults
# auth-service uses (Gmail SMTP over STARTTLS) - swap for your real provider.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Branding shown in email templates - footer, header, links back to the app.
APP_NAME=Garbigo
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@garbigo.com
COMPANY_NAME=Garbigo Ltd
COMPANY_ADDRESS=Nairobi, Kenya

SERVER_PORT=8081
